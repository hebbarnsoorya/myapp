{
  "id": null,
  "title": "PPL Management Service Dashboard",
  "tags": ["spring-boot", "micrometer", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"ppl-management\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"ppl-management\", outcome=\"CLIENT_ERROR\"}[5m])) + sum(rate(http_server_requests_seconds_count{application=\"ppl-management\", outcome=\"SERVER_ERROR\"}[5m]))",
          "legendFormat": "errors/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Duration (p95)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"ppl-management\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Active Requests",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "http_server_requests_active{application=\"ppl-management\"}",
          "legendFormat": "active"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top 5 Slowest Endpoints",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "topk(5, rate(http_server_requests_seconds_sum{application=\"ppl-management\"}[5m]) / rate(http_server_requests_seconds_count{application=\"ppl-management\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 1
      }
    ]
  }
}
